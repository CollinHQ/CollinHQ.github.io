# Copy to .env.local for local development (this file is safe to commit; .env.local is gitignored).

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave blank to disable analytics — nothing loads and no requests are made.
# In production (GitHub Pages), set this as a repository Actions *variable* of the
# same name so the deploy workflow injects it at build time.
VITE_GA_MEASUREMENT_ID=
